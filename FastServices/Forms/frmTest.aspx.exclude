<%@ Page Language="C#" MasterPageFile="~/Forms/AppMaster.master" AutoEventWireup="true" CodeFile="frmTest.aspx.cs" Inherits="Forms_frmTest" Title="Test Page" %>

<asp:Content ID="Content1" ContentPlaceHolderID="mainCopy" Runat="Server">

         <asp:Button ID="btnShow" Text="Show" runat="server" OnClick="btnShow_Click" />
   
        <table>
            <tr>
                <td>                
                    <p style="text-align: center; ">&nbsp;<b><u><span style="font-size:10.0pt; font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font:major-latin;mso-hansi-theme-font: major-latin">Subject: Proposal for Google Apps for Business</span></u></b></p> <p class="MsoNormal"><b><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font: major-latin;mso-hansi-theme-font:major-latin">Dear Sir,<o:p></o:p></span></b></p> <p class="MsoNormal" style="text-align: justify; "><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font: major-latin;mso-hansi-theme-font:major-latin">We take this opportunity to introduce Fast Services to your organization. Fast Services is all set to provide full range of complex, innovative information management solutions to different verticals like corporate, civilian, military and federal clients. We intend to exceed expectations by focusing on each client&rsquo;s absolute satisfaction, enhancing communications, collaboration, emergency response and information security.<o:p></o:p></span></p> <p class="MsoNormal" style="text-align: justify; "><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font: major-latin;mso-hansi-theme-font:major-latin">Fast Services is authorized reseller in Pakistan and Afghanistan by <b>Google. </b>Fast Services provides local support for Google Apps. With reference to your query, please find below the quotation for required product(s). There will be additional charges in case of any change in specification. <o:p></o:p></span></p> <p class="MsoListParagraphCxSpFirst" style="margin-left:0in;mso-add-space:auto; text-align:justify;mso-layout-grid-align:none;text-autospace:none"><b><span style="font-size:10.0pt;font-family: &quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font:major-latin;mso-fareast-font-family: Cambria;mso-hansi-theme-font:major-latin;mso-bidi-font-family:Cambria; mso-fareast-language:EN-US">Google Apps for Business<o:p></o:p></span></b></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.25in;mso-add-space: auto;text-align:justify;mso-layout-grid-align:none;text-autospace:none"><i><span style="font-size:10.0pt;font-family: &quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font:major-latin;mso-fareast-font-family: Cambria;mso-hansi-theme-font:major-latin;mso-bidi-font-family:Cambria; mso-fareast-language:EN-US">Key Features<o:p></o:p></span></i></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Web-based email, calendars, Docs (Word, Excel, Powerpoint and PDF), Sites<o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">25 GB space per user<o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Google Drive 5GB per user for files backup<o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Files and emails are always backed up<o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Strong encryption and authentication<o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Stay connected from anywhere any device e.g. Iphone, blackberry, Android <o:p></o:p></span></p> <p class="MsoListParagraphCxSpMiddle" style="margin-left:.75in;mso-add-space: auto;text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">Use real time data collaboration and work better<o:p></o:p></span></p> <p class="MsoListParagraphCxSpLast" style="margin-left:.75in;mso-add-space:auto; text-align:justify;text-indent:-.25in;mso-list:l0 level1 lfo1;mso-layout-grid-align: none;text-autospace:none"><!--[if !supportLists]--><span style="font-size:10.0pt; font-family:Symbol;mso-fareast-font-family:Symbol;mso-bidi-font-family:Symbol; mso-fareast-language:EN-US">&middot;<span style="font-size: 7pt; font-family: 'Times New Roman'; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><!--[endif]--><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;; mso-ascii-theme-font:major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font: major-latin;mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">For more information, visit </span><a href="http://google.fastservices.pk/"><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font: major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font:major-latin; mso-bidi-font-family:Cambria;mso-fareast-language:EN-US">http://google.fastservices.pk</span></a><span style="font-size:10.0pt;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font: major-latin;mso-fareast-font-family:Cambria;mso-hansi-theme-font:major-latin; mso-bidi-font-family:Cambria;mso-fareast-language:EN-US"> <o:p></o:p></span></p> <p class="MsoNormal" style="margin-left:.25in;text-align:justify;mso-layout-grid-align: none;text-autospace:none"><a name="_GoBack"></a><b><i><span style="font-size:10.0pt; line-height:115%;font-family:&quot;Cambria&quot;,&quot;serif&quot;;mso-ascii-theme-font:major-latin; mso-fareast-font-family:Cambria;mso-hansi-theme-font:major-latin;mso-bidi-font-family: Cambria">Financials</span></i></b></p> 
                </td>
